@online{renNextBlockPrediction2025,
  title = {Next {{Block Prediction}}: {{Video Generation}} via {{Semi-Autoregressive Modeling}}},
  shorttitle = {Next {{Block Prediction}}},
  author = {Ren, Shuhuai and Ma, Shuming and Sun, Xu and Wei, Furu},
