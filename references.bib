  doi = {10.48550/arXiv.2601.19488},
  url = {https://arxiv.org/abs/2601.19488},
  urldate = {2026-09-22},
  abstract = {Prediction errors accumulate as more frames are generated and eventually severely degrade long-horizon quality. To address this, the authors propose Entropy-Guided k-Guard (ENkG) sampling, a training-free, model-agnostic strategy that adapts sampling to token-wise dispersion, quantified by the entropy of each token's predicted distribution. ENkG dynamically adjusts the size of the candidate set for each token according to its entropy: low-entropy regions use fewer candidates to preserve structural integrity, while high-entropy regions use more candidates to mitigate error compounding. A k-guard mechanism enforces minimal exploration even in low-entropy regimes, mitigating degenerate static rollouts and frame-freezing.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
}

